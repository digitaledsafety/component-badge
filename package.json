{
  "name": "@template/web-component",
  "version": "1.0.0",
  "description": "A modern, production-ready Web Component for attribution badges with logo, QR code, and custom styling.",
  "type": "module",
  "main": "./dist/attribution-badge.iife.js",
  "module": "./dist/attribution-badge.js",
  "exports": {
    ".": {
      "import": "./dist/attribution-badge.js",
      "require": "./dist/attribution-badge.iife.js"
    },
    "./define": {
      "import": "./dist/define.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode es && vite build --mode define",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"test/**/*.js\" \"*.md\""
  },
  "keywords": [
    "web-components",
    "attribution-badge",
    "custom-elements",
    "shadow-dom",
    "qr-code",
    "vite"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
